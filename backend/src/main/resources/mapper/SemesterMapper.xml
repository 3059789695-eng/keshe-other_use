<?xml version="1.0" encoding="UTF-8"?>
<!-- 文件：SemesterMapper.xml -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.course.opening.mapper.SemesterMapper">
    <select id="selectById" resultType="com.course.opening.entity.Semester">
        SELECT id, name
        FROM semesters
        WHERE id = #{id}
    </select>
    <select id="selectAll" resultType="com.course.opening.entity.Semester">
        SELECT id, name
        FROM semesters
        ORDER BY id
    </select>
</mapper>
