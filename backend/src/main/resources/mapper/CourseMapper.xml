<?xml version="1.0" encoding="UTF-8"?>
<!-- 文件：CourseMapper.xml -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.course.opening.mapper.CourseMapper">
    <select id="selectById" resultType="com.course.opening.entity.Course">
        SELECT id, title, credits
        FROM courses
        WHERE id = #{id}
    </select>
    <select id="selectAll" resultType="com.course.opening.entity.Course">
        SELECT id, title, credits
        FROM courses
        ORDER BY id
    </select>
</mapper>
