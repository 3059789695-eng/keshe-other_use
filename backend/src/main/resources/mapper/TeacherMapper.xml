<?xml version="1.0" encoding="UTF-8"?>
<!-- 文件：TeacherMapper.xml -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.course.opening.mapper.TeacherMapper">
    <select id="selectById" resultType="com.course.opening.entity.Teacher">
        SELECT id, teacher_no
        FROM teachers
        WHERE id = #{id}
    </select>
    <select id="selectTeacherOptions" resultType="com.course.opening.vo.TeacherOptionVO">
        SELECT t.id, t.teacher_no, u.name
        FROM teachers t
        INNER JOIN users u ON t.id = u.id
        ORDER BY t.id
    </select>
</mapper>
