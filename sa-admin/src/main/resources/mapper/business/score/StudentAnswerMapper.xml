<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.admin.module.business.score.dao.StudentAnswerDao">

    <resultMap id="studentAnswerResultMap" type="net.lab1024.sa.admin.module.business.score.domain.entity.StudentAnswerEntity">
        <id property="answerId" column="answer_id"/>
        <result property="examId" column="exam_id"/>
        <result property="studentId" column="student_id"/>
        <result property="status" column="status"/>
        <result property="verifyFailCount" column="verify_fail_count"/>
        <result property="verifyLockUntil" column="verify_lock_until"/>
        <result property="startAnswerTime" column="start_answer_time"/>
        <result property="lastSaveTime" column="last_save_time"/>
        <result property="submitTime" column="submit_time"/>
        <result property="ipAddress" column="ip_address"/>
        <result property="deviceInfo" column="device_info"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <update id="updateById">
        UPDATE t_student_answer
        SET exam_id          = #{examId},
            student_id       = #{studentId},
            status           = #{status},
            verify_fail_count = #{verifyFailCount},
            verify_lock_until = #{verifyLockUntil},
            start_answer_time = #{startAnswerTime},
            last_save_time    = #{lastSaveTime},
            submit_time       = #{submitTime},
            ip_address        = #{ipAddress},
            device_info       = #{deviceInfo},
            update_time       = #{updateTime}
        WHERE answer_id = #{answerId}
    </update>

    <select id="selectById" resultMap="studentAnswerResultMap">
        SELECT * FROM t_student_answer WHERE answer_id = #{answerId}
    </select>

    <select id="selectByExamIdAndStudent" resultMap="studentAnswerResultMap">
        SELECT * FROM t_student_answer
        WHERE exam_id = #{examId}
          AND student_id = #{studentId}
    </select>

    <select id="selectByAnswerIds" resultMap="studentAnswerResultMap">
        SELECT * FROM t_student_answer
        WHERE answer_id IN
        <foreach collection="answerIds" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>

</mapper>
